<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link for the native Google-auth handoff. OAuth runs in the
                 system browser (Google blocks embedded WebViews); on success
                 kcals.app redirects to kcals://auth-callback?code=… which
                 relaunches this activity. @capacitor/app delivers the URL to
                 the web bridge, which exchanges the one-time code for a
                 session cookie inside the WebView. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kcals" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Health Connect permission-rationale (required by the platform so it
             can link to why we read health data). The activity ships with the
             capacitor-health plugin. -->
        <activity
            android:name="com.fit_up.health.capacitor.PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.fit_up.health.capacitor.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ requires this to be granted at runtime before notifications
         show; @capacitor/push-notifications requestPermissions() prompts for it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health Connect: read the activity data Mi Fitness (com.xiaomi.wearable)
         writes, to auto-fill the daily active-calorie / step figures that drive
         TDEE. Granted by the user in the Health Connect permission sheet. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />

    <!-- Body measurements sync both ways: weigh-ins logged in kcals are written
         to Health Connect (edits and deletes propagate too), while weigh-ins /
         height / body fat recorded by other apps are imported. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Health Connect hands us the package that recorded a day, and we turn
         that into the name and icon Android itself shows for it. Since Android
         11 that lookup needs visibility of the package, and a band can be any
         of dozens of apps — Mi Fitness, Zepp Life, Fitbit, Samsung Health —
         so there's no list to enumerate in <queries> above. Without this the
         lookup throws NameNotFound and every synced day reads "your band".

         Play restricts this permission; kcals is sideloaded to family phones
         and never listed, so no policy applies. The visibility is only ever
         used for the label and icon of an app the user already granted us
         Health Connect data from. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
</manifest>
