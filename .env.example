# Pooled Postgres connection — used by the running app
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Direct (unpooled) Postgres connection — used by Prisma for migrations
DATABASE_URL_UNPOOLED=postgresql://USER:PASS@HOST/DB?sslmode=require

# USDA FoodData Central — get one at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=DEMO_KEY

# Google Generative AI (Gemini) — powers the AI fallback in food search.
# When community + USDA + OFF all return no results, we ask Gemini Flash
# (grounded with Google Search) for a structured nutrition estimate.
# Create one at https://aistudio.google.com/apikey — the free tier is
# enough for normal usage.
GOOGLE_GENERATIVE_AI_API_KEY=

# Auth.js v5 — generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=replace-me
# Google OAuth client (Web application). Redirect URIs in Console must include:
#   https://YOUR_DOMAIN/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend — used to send friend invite emails. Free tier at https://resend.com
# Leave RESEND_API_KEY empty to skip email entirely; the invite UI falls
# back to "copy and share the link yourself".
RESEND_API_KEY=
# Sender address. Must be a verified domain on Resend, or "onboarding@resend.dev"
# (which only delivers to your own account email — fine for testing).
EMAIL_FROM=kcals <onboarding@resend.dev>

# Public base URL — the single source of truth for the app's own host.
# Used for OG/Twitter metadataBase, invite email links, and the OG card host
# badge. Set this explicitly for local dev and for any custom production
# domain. If unset, falls back to VERCEL_PROJECT_PRODUCTION_URL, then
# http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
