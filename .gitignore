# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal

# Capacitor (native/) — build artifacts & secrets. The android/ project
# itself is committed (we customize the manifest, icons, etc.); only its
# generated build output, injected web assets, and secrets are ignored.
/native/node_modules
/native/android/.gradle
/native/android/build
/native/android/app/build
/native/android/capacitor-cordova-android-plugins
/native/android/app/src/main/assets/public
/native/android/app/src/main/assets/capacitor.config.json
/native/android/app/src/main/assets/capacitor.plugins.json
/native/android/app/google-services.json
/native/android/local.properties
/native/android/keystore.properties
*.keystore
firebase-service-account*.json

# Local Claude Code config & worktrees
.claude/
