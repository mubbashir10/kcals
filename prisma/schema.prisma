// Multi-user app — Google sign-in only.
// See https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────────────────────────────────────────────
// Auth.js v5 models (https://authjs.dev/getting-started/adapters/prisma)
// ───────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  // App relations
  profile      Profile?
  weightLogs   WeightLog[]
  activityLogs ActivityLog[]
  meals        Meal[]
  recipes      Recipe[]
  // Custom foods this user contributed to the shared library.
  createdCustomFoods CustomFood[] @relation("CustomFoodCreatedBy")

  // Friends — canonical: every friendship is stored as one row with
  // userAId < userBId, so each user shows up on either side.
  friendshipsA    Friendship[]   @relation("FriendshipUserA")
  friendshipsB    Friendship[]   @relation("FriendshipUserB")
  invitesSent     FriendInvite[] @relation("InvitesSent")
  invitesAccepted FriendInvite[] @relation("InvitesAccepted")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────────────────────────────────────────────────────
// App models — each row belongs to a User
// ───────────────────────────────────────────────────────────────────────

model Profile {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  age        Int
  sex        String // "male" | "female"
  heightCm   Float
  weightKg   Float
  bodyFatPct Float?
  units      String @default("metric") // "metric" | "imperial"
  timezone   String @default("UTC") // IANA timezone, e.g. "America/New_York" — drives all date/time math in the app

  // Goal — drives the "effective calorie target" used by the ring + macros.
  //   "loss"     → eat below TDEE by goalPace's deficit
  //   "gain"     → eat above TDEE by goalPace's surplus
  //   "maintain" → effective target = TDEE
  //   "track"    → user-set target via trackKcal; falls back to TDEE if null
  goalType  String  @default("maintain") // "loss" | "maintain" | "gain" | "track"
  goalPace  String? // "mild" | "moderate" | "aggressive" — only set when goalType is loss/gain
  trackKcal Int? // user-chosen daily kcal target; only read when goalType is "track"

  // Macro goals — three modes per macro:
  //   "auto"   → derived from calorie target × default split (30/40/30 P/C/F)
  //   "custom" → use the corresponding *GoalG column (in grams)
  //   "off"    → not tracked; UI shows ∞ and skips the progress bar
  proteinGoalMode String @default("auto")
  proteinGoalG    Int?
  carbsGoalMode   String @default("auto")
  carbsGoalG      Int?
  fatGoalMode     String @default("auto")
  fatGoalG        Int?

  // Activity — for TDEE / maintenance-calorie calculation
  activityMode             String @default("estimate") // "estimate" | "override"
  stepsPerDay              Int? // avg daily steps (estimate mode)
  liftingSessionsPerWeek   Int? // strength training freq (estimate mode)
  liftingMinutesPerSession Int? // avg duration; defaults to 60 if null
  cardioSessionsPerWeek    Int? // cardio freq (estimate mode)
  cardioMinutesPerSession  Int? // avg duration; defaults to 30 if null
  activeKcalOverride       Int? // wearable-tracker number (override mode)

  // Per-widget state on the home dashboard. JSON map of
  //   { [widgetId]: "expanded" | "minimized" | "hidden" }
  // Missing keys fall back to "expanded". See REORDERABLE_WIDGETS for the
  // current set of widget IDs.
  widgetStates   String  @default("{}")
  // Calorie ring display — "remaining" (default) shows what's left to eat;
  // "consumed" shows what's been eaten so far.
  calorieDisplay String  @default("remaining")
  // JSON array of widget IDs in display order. NULL = default order.
  widgetOrder    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A single daily weight measurement. We always store kg internally.
model WeightLog {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weightKg  Float
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, loggedAt])
}

// One row per day in the user's timezone. Snapshots the TDEE math at
// the time the row is touched so historical days remain stable even
// after the user changes their profile defaults later.
//
// Read order for the day's active kcal:
//   overrideActiveKcal (when user logged today's actual)  →  fall back to
//   defaultActiveKcal (snapshot of "typical day" estimate)
//
// TDEE is precomputed and stored in `tdeeKcal`.
model ActivityLog {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // YYYY-MM-DD in the user's timezone at the moment the row was created.
  dayKey String

  // Override inputs — present only when the user logged today's actual
  // activity. `mode` distinguishes estimate-style (steps/lift/cardio
  // duration) from a wearable-pasted total.
  mode         String // "estimate" | "override"
  steps        Int? // estimate mode
  liftingMin   Int? // estimate mode — minutes that day
  cardioMin    Int? // estimate mode — minutes that day
  wearableKcal Int? // override mode — total active kcal from wearable

  // Daily TDEE snapshots — written by the actions whenever the row is
  // upserted, so reads never recompute on the fly.
  bmrKcal            Float? // snapshot of BMR for that day
  defaultActiveKcal  Float? // snapshot of the user's typical-day estimate
  overrideActiveKcal Float? // active kcal computed from override inputs (null when no override)
  tdeeKcal           Float? // bmrKcal + (overrideActiveKcal ?? defaultActiveKcal)

  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayKey])
  @@index([userId, loggedAt])
}

// A Meal is a container for one or more Foods eaten together.
model Meal {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String? // "Breakfast", "Lunch", "Dinner", "Snack" — optional
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  foods Food[]

  @@index([userId, loggedAt])
}

// A community-contributed custom food — the ones USDA doesn't have
// (homemade recipes, regional brands, restaurants, etc.). Once saved
// by any user, the entry is visible in every user's search so we don't
// duplicate work. We attribute the creator (for moderation) and surface
// `createdAt` in search results so users can prefer recent submissions.
//
// All nutrients are stored per 100g, matching the canonical form we
// normalize USDA results to. Optional nutrients are null when unknown.
model CustomFood {
  id Int @id @default(autoincrement())

  // Who added it. Kept for attribution and moderation; we do not show
  // the contributor's name in UI by default.
  createdById String
  createdBy   User   @relation("CustomFoodCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  // Identity
  name  String
  brand String?

  // Required: how many kcal in 100g of this food.
  kcal Float

  // Macros per 100g — null when unknown rather than 0, so we can show
  // "—" instead of pretending it's actually zero.
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  fiberG       Float?
  sugarG       Float?
  saturatedFatG Float?
  sodiumMg     Float?
  cholesterolMg Float?

  // Optional default serving — e.g. 250g labelled "1 cup".
  servingSizeG Float?
  servingLabel String?

  // Where this entry came from. "USER" = manually entered via the custom
  // food dialog. "AI" = generated by the AI fallback (Gemini + Google
  // search) and saved on user approval. AI rows are flagged in the UI
  // so users know to sanity-check the numbers before relying on them.
  source CustomFoodSource @default(USER)

  // Provenance for AI entries — null for user-entered ones.
  aiModel   String?
  aiSources String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
}

enum CustomFoodSource {
  USER
  AI
}

// A single logged food item inside a meal. Nutrients are stored
// as logged (i.e. already scaled to the user's portion), not per 100g.
model Food {
  id     Int  @id @default(autoincrement())
  mealId Int
  meal   Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  fdcId     Int? // USDA FoodData Central id (null for manual entries)
  // When this row came from logging a Recipe, the source recipe id.
  // SetNull on delete so a deleted recipe doesn't nuke the diary row —
  // the nutrient snapshot still tells the historical story.
  recipeId  Int?
  recipe    Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  name      String
  brand     String?
  grams     Float // serving size logged
  kcal      Float
  proteinG  Float    @default(0)
  carbsG    Float    @default(0)
  fatG      Float    @default(0)
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([mealId])
  @@index([loggedAt])
  @@index([recipeId])
}

// A user's private recipe — a composition of ingredient foods. Stored
// per-user (not shared), with a snapshot per ingredient so changes to the
// upstream USDA/CustomFood row don't silently re-derive an old recipe.
//
// totalWeightG is user-set (cooked weight), NOT a sum of ingredient
// grams — cooking changes weight (reduction, added water, etc.). All
// per-portion math derives from total nutrients / totalWeightG.
model Recipe {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  // Final cooked weight of the whole recipe. Optional: when null, we
  // derive it as the sum of ingredient grams. Set it explicitly when
  // cooking changes the weight (reduction, added liquid, etc.).
  totalWeightG Float?
  servings     Float? // optional: "makes N servings". 1 serving = effectiveTotalWeight / servings.

  ingredients RecipeIngredient[]
  // Diary rows that were created by logging this recipe.
  foods       Food[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// One ingredient inside a Recipe. We store both the source pointer
// (fdcId, positive = USDA, negative = CustomFood — matches the same
// convention Food and the search API already use) AND a snapshot of the
// nutrient profile at the moment it was added. That way, edits or
// deletions upstream don't quietly change an old recipe's macros.
model RecipeIngredient {
  id       Int    @id @default(autoincrement())
  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  // Source pointer — positive = USDA fdcId, negative = -customFoodId.
  // Null for ingredients added entirely manually (kcal-only quick adds).
  fdcId Int?

  // Snapshot of the ingredient as it was when added.
  name         String
  brand        String?
  per100Kcal     Float
  per100ProteinG Float @default(0)
  per100CarbsG   Float @default(0)
  per100FatG     Float @default(0)

  // How much of this ingredient went into the recipe.
  grams    Float
  // Stable display order in the builder.
  position Int   @default(0)

  createdAt DateTime @default(now())

  @@index([recipeId])
}

// ───────────────────────────────────────────────────────────────────────
// Friends — read-only sharing of daily stats between users.
// ───────────────────────────────────────────────────────────────────────

// One row per friendship. To make uniqueness and lookup trivial, we always
// store with userAId < userBId (canonical ordering) and check both sides
// at query time.
model Friendship {
  id      Int    @id @default(autoincrement())
  userAId String
  userBId String
  userA   User   @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB   User   @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userBId])
}

// A pending invite. `token` is always set (used in the shareable URL).
// `email` is optional — when set, only that address may accept (and the
// invite is also surfaced as a banner to the matching signed-in user).
model FriendInvite {
  id        Int    @id @default(autoincrement())
  token     String @unique
  inviterId String
  inviter   User   @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)

  email String?

  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?     @relation("InvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([inviterId])
  @@index([email])
}
